# SETU Configuration Example
# Copy this file to backend/.env and fill in real values there.
# backend/.env is gitignored — never commit real secrets.

# Set this to YOUR local Postgres user/password/db (the default below is a placeholder).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/setu_db
SECRET_KEY=change-this-in-production
DEBUG=True

# Each *_PROVIDER switch picks which implementation the corresponding module uses.
# "mock" = canned/simulated data, no external call, no key needed.
SPEECH_PROVIDER=mock          # mock | bhashini | sarvam (auto-detects the spoken Indian language)
EXTRACTION_PROVIDER=gemini    # mock | openai | gemini
TELEPHONY_PROVIDER=mock       # mock | twilio | telnyx — telnyx is the one verified against real live calls
NOTIFICATION_PROVIDER=mock    # mock | email | msg91 | twilio | telnyx — email is a real-send option needing no
                               # SMS/DLT registration; SMS providers are built but blocked on India's DLT
                               # sender-ID registration for anything beyond fixed template text (see below)
MAP_PROVIDER=mock             # unused — the current maps module works from stored coordinates, no external API needed

# --- Telephony + SMS via Telnyx (the provider verified against real live
#     calls — recommended if you're wiring up real telephony) -------------
# backend/app/modules/calls/providers/telnyx.py places outbound calls via
# Telnyx's native Call Control API (JSON webhook events), NOT TeXML — a
# TeXML Application's "account_sid" is undocumented/unobtainable, a dead
# end confirmed the hard way. TELNYX_CONNECTION_ID (a Call Control
# Application / "Voice API Application" in the Telnyx portal) is what
# actually matters for real calls; TELNYX_ACCOUNT_SID and
# TELNYX_TEXML_APPLICATION_SID are legacy/unused, kept only in case a
# future session revisits the TeXML path with a real answer.
# SMS via Telnyx needs only TELNYX_API_KEY + TELNYX_PHONE, with real custom
# message text (no Twilio-style trial template restriction) — but see the
# NOTIFICATION_PROVIDER=email note above: production SMS to India still
# needs DLT sender-ID registration regardless of provider, a regulatory
# process independent of any of this configuration.
# Calls also need PUBLIC_BASE_URL below (a publicly reachable HTTPS URL —
# e.g. an ngrok tunnel — for Telnyx to deliver webhook events to).
TELNYX_API_KEY=
TELNYX_PHONE=
TELNYX_CONNECTION_ID=
TELNYX_ACCOUNT_SID=
TELNYX_TEXML_APPLICATION_SID=

# Publicly reachable base URL (e.g. an ngrok tunnel: `ngrok http 8000`) for
# this backend. Required for real Telnyx/Twilio call webhooks to reach you.
PUBLIC_BASE_URL=

# --- Telephony + SMS via Twilio (alternative to Telnyx) -------------------
# backend/app/modules/calls/providers/twilio.py. A TRIAL Twilio account can
# only call/text phone numbers you've verified in the Twilio console, and
# (as of late 2026) trial accounts also restrict SMS to a handful of fixed
# template messages and reject inline TwiML on calls — real behavior needs
# either a paid account or PUBLIC_BASE_URL-based webhooks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# --- SMS via MSG91 (alternative SMS-only provider) ------------------------
MSG91_API_KEY=

# --- Email (NOTIFICATION_PROVIDER=email) — real reminder/notification
#     delivery with no telephony account or DLT registration needed -------
# backend/app/modules/notifications/providers/email.py sends via plain
# SMTP (e.g. a Gmail account with an App Password — not your real
# password). Same NotificationProvider interface as every other provider;
# swap back to telnyx/twilio once DLT registration is done, nothing else
# in the pipeline changes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SETU Care Team

# --- Gemini — extraction, chat responses, RAG embeddings, prescription vision ---
# backend/app/core/providers.py centralizes the Gemini client. Used by:
#   - extraction/providers/gemini.py   (symptom + prescription text extraction)
#   - chat/providers/gemini.py         (phrases chat replies; severity is still
#                                        decided by ChatService's deterministic
#                                        keyword rules, never by Gemini)
#   - rag/providers/embeddings.py      (semantic search over ingested guidance docs)
#   - prescriptions/providers/vision.py (reads prescription photos directly)
# Every one of these falls back safely (mock data / keyword search / a clear
# "gemini_unavailable" error) if this key is missing or a call fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- OpenAI (alternative extraction provider) -----------------------------
OPENAI_API_KEY=

# --- Speech-to-text (real transcription of phone check-in call recordings) ---
# backend/app/modules/speech/providers/sarvam.py — auto-detects the spoken
# Indian language rather than assuming Hindi/English.
BHASHINI_API_KEY=
SARVAM_API_KEY=

# --- Local timezone offset, in minutes from UTC ---------------------------
# Every timestamp in the database is stored as naive UTC. Anything expressed
# as a human clock time (a medication reminder "at 8 in the morning", a
# patient-chosen daily call time) is converted through this offset before
# being stored — otherwise it fires 5.5 hours off. Defaults to IST (+330).
LOCAL_UTC_OFFSET_MINUTES=330
