# SETU Configuration Example
# Copy this file to backend/.env and fill in real values there.
# backend/.env is gitignored — never commit real secrets.

# Set this to YOUR local Postgres user/password/db (the default below is a placeholder).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/setu_db
SECRET_KEY=change-this-in-production
DEBUG=True

# Each *_PROVIDER switch picks which implementation the corresponding module uses.
# "mock" = canned/simulated data, no external call, no key needed.
SPEECH_PROVIDER=mock          # mock | bhashini | sarvam | indicwhisper (specialized Indian-language STT — kept separate from Gemini)
EXTRACTION_PROVIDER=gemini    # mock | openai | gemini
TELEPHONY_PROVIDER=twilio     # mock | twilio | telnyx
NOTIFICATION_PROVIDER=twilio  # mock | msg91 | twilio | telnyx
MAP_PROVIDER=mock             # unused — the current maps module works from stored coordinates, no external API needed

# --- Telephony + SMS (real Twilio calls & SMS) ----------------------------
# backend/app/modules/calls/providers/twilio.py places real outbound calls
# (inline TwiML greeting + recording, no public webhook required) and real
# SMS. backend/app/modules/notifications/providers/twilio.py reuses it for
# NOTIFICATION_PROVIDER=twilio. A TRIAL Twilio account can only call/text
# phone numbers you've verified in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# Optional: a publicly reachable base URL (e.g. an ngrok tunnel) for this
# backend. When set, Twilio calls use real webhooks for a full interactive
# IVR instead of the simpler inline-TwiML greeting+recording.
PUBLIC_BASE_URL=

# --- SMS via MSG91 (alternative to Twilio SMS) ----------------------------
MSG91_API_KEY=

# --- Telephony + SMS via Telnyx (alternative to Twilio) --------------------
# backend/app/modules/calls/providers/telnyx.py and
# backend/app/modules/notifications/providers/telnyx.py. SMS works with just
# the first two vars below (custom message text, no Twilio-style trial
# template restriction). Calls need all four — Telnyx has no inline-TwiML
# equivalent, so a TeXML Application must exist in the Telnyx Mission
# Control Portal with its Voice URL pointing at a live public endpoint
# (same PUBLIC_BASE_URL requirement as Twilio calls above).
TELNYX_API_KEY=
TELNYX_PHONE=
TELNYX_ACCOUNT_SID=
TELNYX_TEXML_APPLICATION_SID=

# --- Gemini — extraction, chat responses, RAG embeddings, prescription vision ---
# backend/app/core/providers.py centralizes the Gemini client. Used by:
#   - extraction/providers/gemini.py   (symptom + prescription text extraction)
#   - chat/providers/gemini.py         (phrases chat replies; severity is still
#                                        decided by ChatService's deterministic
#                                        keyword rules, never by Gemini)
#   - rag/providers/embeddings.py      (semantic search over ingested guidance docs)
#   - prescriptions/providers/vision.py (reads prescription photos directly)
# Every one of these falls back safely (mock data / keyword search / a clear
# "gemini_unavailable" error) if this key is missing or a call fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- OpenAI (alternative extraction provider) -----------------------------
OPENAI_API_KEY=

# --- Speech-to-text (regional language IVR) -------------------------------
BHASHINI_API_KEY=
SARVAM_API_KEY=
